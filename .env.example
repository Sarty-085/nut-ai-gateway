# ==============================================================================
# NUT AI — PRIVATE AI GATEWAY CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env on your gateway server / deployment environment.
# NEVER commit .env with real credentials into source control.
# ==============================================================================

# Network & Server Port
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Normal App Access Tokens (comma-separated list of revocable client tokens)
# Mobile clients send this via 'Authorization: Bearer <token>' or 'x-nutai-app-token'
APP_TOKENS=nutai-app-default-token,client-device-token-abc123

# Administrator Secret Key (required for /v1/admin/* endpoints)
# NEVER share this with standard mobile users or expose in client bundles.
ADMIN_TOKEN=nutai-admin-supersecret-token-change-in-production

# ------------------------------------------------------------------------------
# Provider Credential Pool (Dynamic Discovery)
# ------------------------------------------------------------------------------
# Define 1 to N credentials per provider. The gateway discovers all numbered keys.

# Google Gemini Credential Pool
GOOGLE_API_KEY_1=your-google-api-key-primary
# GOOGLE_API_KEY_2=your-google-api-key-secondary
# GOOGLE_API_KEY_3=your-google-api-key-tertiary

# Anthropic Claude Credential Pool
ANTHROPIC_API_KEY_1=your-anthropic-api-key-primary
# ANTHROPIC_API_KEY_2=your-anthropic-api-key-secondary

# OpenAI Credential Pool
OPENAI_API_KEY_1=your-openai-api-key-primary
# OPENAI_API_KEY_2=your-openai-api-key-secondary

# Provider Priority Order (comma-separated list of provider IDs)
AI_PROVIDER_ORDER=google,anthropic,openai

# ------------------------------------------------------------------------------
# Default Models Per Task
# ------------------------------------------------------------------------------
MODEL_FOOD_ANALYSIS=gemini-2.5-flash
MODEL_LABEL_SCAN=gemini-2.5-flash
MODEL_RECEIPT_SCAN=gemini-2.5-flash
MODEL_WEB_LOOKUP=gemini-2.5-flash
MODEL_EXERCISE_ESTIMATE=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Rate Limiting & Usage Protection
# ------------------------------------------------------------------------------
# Maximum requests per client token per minute
RATE_LIMIT_PER_MINUTE=60

# Maximum requests per client token per 24 hours
RATE_LIMIT_DAILY=1000

# Maximum total requests across all clients per minute
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# Optional daily cost ceiling in USD across all providers (e.g. 50.00)
# DAILY_COST_CAP_USD=50.00

# ------------------------------------------------------------------------------
# Request Deduplication & Retries
# ------------------------------------------------------------------------------
# Deduplication window in milliseconds for identical image/payload requests
DEDUP_WINDOW_MS=5000

# Maximum retry attempts on transient upstream failures (e.g. 503, network)
MAX_RETRIES=2

# Default cooldown duration in milliseconds for rate-limited (429) resources
COOLDOWN_MS=60000
